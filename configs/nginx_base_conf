# Other old GUI routes retain their path for v1. Unknown v2 routes fall back
# to the v2 home instead of claiming an unsafe arbitrary redirect.
location ~ ^/nomad-oasis/gui(?:/(?<legacy_gui_path>.*))?$ {
    if ($cookie_nomad_gui_pref = "v1") { return 302 /gui/$legacy_gui_path$is_args$args; }
    if ($cookie_nomad_gui_pref = "v2") { return 302 /$is_args$args; }
    return 302 /select-gui$is_args$args;
}

# This must be an anchored regex, and it must appear before the generic
# /api/v1 regex locations below. A normal prefix location is insufficient:
# those regexes also match the old path and would bypass the compatibility
# rewrite for uploads and downloads.
location ~ ^/nomad-oasis/(?:api|north|optimade|dcat|h5grove|dashboards|docs|metrics|alive|temporal)(?:/|$) {
    rewrite ^/nomad-oasis/(.*)$ /backend/$1 last;
}

# All remaining non-GUI routes under the old base path belonged to the backend
# (including arbitrary API entry-point prefixes).
location = /nomad-oasis {
    return 302 /$is_args$args;
}

location = /nomad-oasis/ {
    return 302 /$is_args$args;
}

location /nomad-oasis/ {
    rewrite ^/nomad-oasis/(.*)$ /backend/$1 last;
}

# ⚠️ LOCAL: docs go to the official site. The image builds no docs (NOMAD_DOCS_REPO is empty in
# docker-publish.yml) and nomad-lab 2.0 links them via `documentation.url`. The template's
# "404 -> /backend/docs/404.html" rule must not come back without built docs: 404.html is itself
# a 404, so it redirects to itself forever. Old /nomad-oasis/docs URLs reach here through the
# rewrite above.
location = /docs {
    return 302 https://docs.nomad-lab.eu/;
}

location /docs/ {
    return 302 https://docs.nomad-lab.eu/;
}

location /backend/docs/ {
    return 302 https://docs.nomad-lab.eu/;
}

location ~ \/gui\/(service-worker\.js|meta\.json)$ {
    add_header Last-Modified $date_gmt;
    add_header Cache-Control 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0';
    if_modified_since off;
    expires off;
    etag off;
    proxy_pass http://nomad-app-backend;
}

# Match downloads before the broader raw-file upload rule below.
location ~ /api/v1/(.*/download|uploads/[^/]+/export/?$) {
    proxy_buffering off;
    proxy_pass http://nomad-app-backend;
}

# Legacy bundle endpoints support both imports and exports.
location ~ /api/v1/uploads/[^/]+/bundle/?$ {
    client_max_body_size 35g;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_pass http://nomad-app-backend;
}

# Stream uploads and imports without buffering the request.
location ~ /api/v1/uploads(/?$|/import/?$|/[^/]+/raw(/|$)) {
    client_max_body_size 35g;
    proxy_request_buffering off;
    proxy_pass http://nomad-app-backend;
}

# ⚠️ LOCAL: eLabFTW sample tracker -- NOT part of NOMAD. A separate compose project
# (CRC270-HoMMage/elab-sample-tracking) that joins nomad_oasis_network as `elab-tracker`.
#
# The path is passed through UNSTRIPPED (proxy_pass has no URI part). The tracker runs with
# SCRIPT_NAME=/elab-tracker and strips the prefix itself; rename one and you must rename the
# other. A request for /elab-tracker without the slash is redirected here by nginx.
#
# ⚠️ Keep the `set` + `resolver` pair. A literal hostname in proxy_pass is resolved once, at
# startup, and nginx refuses to start if it does not resolve -- so with the tracker stopped,
# restarting this proxy would take the whole Oasis down. A variable defers the lookup to
# request time (via Docker's embedded DNS), and a missing tracker is a 502 on this path only.
#
# ^~ keeps the regex locations above from ever claiming a tracker URL, and beats the GUI v2
# catch-all `location /` as the longer prefix.
location ^~ /elab-tracker/ {
    resolver 127.0.0.11 valid=30s;
    set $elab_tracker http://elab-tracker:5000;
    proxy_pass $elab_tracker;

    # A search walks a whole eLabFTW collection. Must exceed the tracker's GUNICORN_TIMEOUT
    # (180s), or nginx gives up before gunicorn can report what went wrong.
    proxy_read_timeout 200s;

    # The tracker sets these three itself; the server block adds them to every response.
    # Hiding the upstream copies leaves one of each instead of two that disagree.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
}

# ⚠️ LOCAL: NORTH runs on the GPU host (.102), reached over WireGuard -- `north` does not
# resolve via docker DNS here. An IP literal also sidesteps nginx's startup-only DNS resolution.
# Port 9000 is the hub's PUBLIC proxy port (8081 is its internal API and never crosses hosts).
# The hub serves below BASE_URL=/backend/north/ (docker-compose.north.yml); the two must match.
location /backend/north/ {
    client_max_body_size 500m;
    proxy_pass http://10.10.0.2:9000;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # websocket headers
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Scheme $scheme;

    proxy_buffering off;
}
