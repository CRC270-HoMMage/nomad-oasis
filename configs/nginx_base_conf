# Shared nginx config for both HTTP and HTTPS

# Do not advertise the nginx version in responses / error pages.
server_tokens off;

gzip_min_length     1000;
gzip_buffers        4 8k;
gzip_http_version   1.0;
gzip_disable        "msie6";
gzip_vary           on;
gzip on;
gzip_proxied any;
gzip_types
    text/css
    text/javascript
    text/xml
    text/plain
    application/javascript
    application/x-javascript
    application/json;

# Every app location proxies to the nomad-app-backend upstream (defined in nginx_http.conf /
# nginx_https.conf), so the app's address lives in exactly one place per entrypoint and every
# route gets the same keep-alive pool.
#
# ⚠️ Do NOT add proxy_set_header here. nginx REPLACES the inherited set rather than merging:
# a single proxy_set_header in a location discards every one from the server level -- including
# Host and the Connection "" that keep-alive requires. Host, X-Real-IP, X-Forwarded-For and
# X-Forwarded-Proto are set once at server level; adding one line here silently drops all four.

# Catch-all: forward to the NOMAD app.
location / {
    proxy_pass http://nomad-app-backend;
}

location ~ /nomad-oasis\/?(gui)?$ {
    rewrite ^ /nomad-oasis/gui/v2/ permanent;
}

location /nomad-oasis/gui/ {
    proxy_intercept_errors on;
    error_page 404 = @redirect_to_index;
    proxy_pass http://nomad-app-backend;
}

location @redirect_to_index {
    rewrite ^ /nomad-oasis/gui/index.html break;
    proxy_pass http://nomad-app-backend;
}

location /nomad-oasis/docs/ {
    # This is added to force a redirect (302) when 404 otherwise
    # the assets are not loaded correctly (a broken page rendered)
    proxy_intercept_errors on;
    error_page 404 = @docs404redirect;
    proxy_pass http://nomad-app-backend;
}

location @docs404redirect {
    return 302 /nomad-oasis/docs/404.html;
}

location ~ \/gui\/(service-worker\.js|meta\.json)$ {
    add_header Last-Modified $date_gmt;
    add_header Cache-Control 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0';
    if_modified_since off;
    expires off;
    etag off;
    proxy_pass http://nomad-app-backend;
}

location ~ /api/v1/uploads(/?$|.*/raw|.*/bundle?$)  {
    client_max_body_size 35g;
    proxy_request_buffering off;
    proxy_pass http://nomad-app-backend;
}

location ~ /api/v1/.*/download {
    proxy_buffering off;
    proxy_pass http://nomad-app-backend;
}

# eLabFTW sample tracker -- NOT part of NOMAD. A separate compose project
# (CRC270-HoMMage/elab-sample-tracking) that joins nomad_oasis_network as `elab-tracker`.
#
# The path is passed through UNSTRIPPED (proxy_pass has no URI part). The tracker runs with
# SCRIPT_NAME=/elab-tracker and strips the prefix itself; rename one and you must rename the
# other. A request for /elab-tracker without the slash is redirected here by nginx.
#
# ⚠️ Keep the `set` + `resolver` pair. A literal hostname in proxy_pass is resolved once, at
# startup, and nginx refuses to start if it does not resolve -- so with the tracker stopped,
# restarting this proxy would take the whole Oasis down. A variable defers the lookup to
# request time (via Docker's embedded DNS), and a missing tracker is a 502 on this path only.
#
# ^~ keeps the unanchored regex locations above from ever claiming a tracker URL.
location ^~ /elab-tracker/ {
    resolver 127.0.0.11 valid=30s;
    set $elab_tracker http://elab-tracker:5000;
    proxy_pass $elab_tracker;

    # A search walks a whole eLabFTW collection. Must exceed the tracker's GUNICORN_TIMEOUT
    # (180s), or nginx gives up before gunicorn can report what went wrong.
    proxy_read_timeout 200s;

    # The tracker sets these three itself; the server block adds them to every response.
    # Hiding the upstream copies leaves one of each instead of two that disagree.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
}

location /nomad-oasis/north/ {
    client_max_body_size 500m;
    # NORTH runs on the GPU host (.102), reached over WireGuard -- `north` no longer resolves
    # via docker DNS here. An IP literal also sidesteps nginx's startup-only DNS resolution.
    # Port 9000 is the hub's PUBLIC proxy port (8081 is its internal API and never crosses hosts).
    proxy_pass http://10.10.0.2:9000;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # websocket headers
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Scheme $scheme;

    proxy_buffering off;
}
